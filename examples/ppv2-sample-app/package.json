{
  "name": "@kohaku-eth/ppv2-sample-app",
  "version": "0.0.1",
  "description": "Sample wallet integration of the Privacy Pools v2 Kohaku plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "start:devnet": "tsx src/devnet-main.ts",
    "check:read": "tsx checks/read/readAccount.ts",
    "check:register": "tsx checks/keystore/registerKeystore.ts",
    "check:shield": "tsx checks/deposit/shield.ts",
    "check:transfer": "tsx checks/transfer/transfer.ts",
    "check:unshield": "tsx checks/withdraw/unshield.ts",
    "check:ragequit": "tsx checks/ragequit/ragequit.ts",
    "check:exportImport": "tsx checks/account/exportImport.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "@kohaku-eth/plugins": "workspace:*",
    "@kohaku-eth/privacy-pools": "workspace:*",
    "@kohaku-eth/provider": "workspace:*",
    "viem": "^2.51.3"
  },
  "optionalDependencies": {
    "@0xbow-io/privacy-pools-v2-sdk": "0.1.0-beta.0"
  },
  "devDependencies": {
    "tsx": "^4.17.0",
    "typescript": "^5.9.2"
  }
}
