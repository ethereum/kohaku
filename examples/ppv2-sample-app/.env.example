# Copy to .env (gitignored). NEVER commit the real key.
SEPOLIA_PRIVATE_KEY=0x...
# Optional overrides:
# SEPOLIA_RPC_URL=https://sepolia.drpc.org
# DEPOSIT_WEI=1000
# WITHDRAW_WEI=300            # unshield through the live relayer (needs an approved note)
# TRANSFER_WEI=200            # private transfer via the live relayer (with TRANSFER_TO)
# TRANSFER_TO=0x...
# READ_ONLY=1                 # validate the read path without sending anything
# CIRCUITS_DIR=/abs/path/to/v2-monorepo/packages/circuits/build
# SYNC_FROM_BLOCK=10932482   # deployment block; only for accounts with existing deposits
